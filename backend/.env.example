APP_NAME="University LMS"
APP_ENV=production
# Generate locally: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://lms.example.edu
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# MySQL/MariaDB for the application; SQLite is reserved for in-memory tests.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=university_lms
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# null for one origin; parent domain only for trusted subdomains.
SESSION_DOMAIN=null
# Set false ONLY for local plain HTTP development.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Must match frontend VITE_AUTH_MODE.
LMS_AUTH_MODE=cookie
# Hostnames and ports, without scheme, for the trusted SPA only.
SANCTUM_STATEFUL_DOMAINS=lms.example.edu
CORS_ALLOWED_ORIGINS=https://lms.example.edu
CACHE_STORE=file
BCRYPT_ROUNDS=12
# Private uploads; never expose storage/app/private with a public symlink.
FILESYSTEM_DISK=local
# No worker/Redis service: configure the scheduler cron in docs/DEPLOY.md.

# First install only: unique email and >=12-character mixed password.
# Quote values containing spaces or #. Never add .env to version control.
LMS_ADMIN_NAME="University administrator"
LMS_ADMIN_EMAIL=
LMS_ADMIN_PASSWORD=
# Optional random >=32-character token for /install/{token}; remove after use.
LMS_INSTALLER_TOKEN=
